{
  "redirects": [
    {
      "source": "/category.html",
      "has": [
        {
          "type": "query",
          "key": "c",
          "value": "(?<cat>[a-z0-9-]+)"
        }
      ],
      "destination": "/category/:cat.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(promotions|feed)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/go/:slug",
      "destination": "/api/go?slug=:slug"
    },
    {
      "source": "/deals",
      "destination": "/deals/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/refund",
      "destination": "/refund.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer.html"
    }
  ]
}