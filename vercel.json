        {
          "type": "query",
          "key": "c",
          "value": "(?<cat>[a-z0-9-]+)"
        }
      ],
      "destination": "https://aiuseflow.com/category/:cat.html",
      "statusCode": 301
    },
    {
      "source": "/category.html",
      "destination": "https://aiuseflow.com/",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "https://aiuseflow.com/",
      "statusCode": 301
    },
    {
      "source": "/:p(privacy|terms|refund|disclaimer|login|signup|account)(\\.html)?",
      "destination": "https://aiuseflow.com/:p",
      "statusCode": 301
    },
    {
      "source": "/",
      "destination": "https://aiuseflow.com/",
      "statusCode": 301
    },
    {
      "source": "/:path((?!google90f201efb6ea8dc1\\.html$).*)",
      "destination": "https://aiuseflow.com/:path",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(promotions|feed)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(tools\\.json|embed\\.js)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(signup|login|account)(\\.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(checkout|admin-orders)(\\.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/go/:slug",
      "destination": "/api/go?slug=:slug"
    },
    {
      "source": "/deals",
