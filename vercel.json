{
  "redirects": [
    {
      "source": "/category.html",
      "has": [
        {
          "type": "query",
          "key": "c",
          "value": "(?<cat>[a-z0-9-]+)"
        }
      ],
      "destination": "/category/:cat.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(promotions|feed)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(tools\\.json|embed\\.js)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(signup|login|account)(\\.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(checkout|admin-orders)(\\.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/go/:slug",
      "destination": "/api/go?slug=:slug"
    },
    {
      "source": "/deals",
      "destination": "/deals/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/refund",
      "destination": "/refund.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    }
  ]
}